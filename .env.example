# Copy to .env (gitignored) and fill in values from the Supabase dashboard.
# Loaded at build time: flutter run --dart-define-from-file=.env
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional, debug builds only: show email + password sign-in on the sign-in
# screen, for test accounts. Ignored in release builds.
ENABLE_TEST_LOGIN=false
